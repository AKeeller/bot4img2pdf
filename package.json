{
  "name": "bot4img2pdf",
  "description": "Telegram bot for img2pdf",
  "author": "Alberto Amoruso",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "build": "npx tsc",
    "test": "npm run build && node --test --test-isolation=none --test-timeout=30000 \"test/*.test.cjs\"",
    "test:coverage": "npm run build && node --test --test-isolation=none --test-timeout=30000 --experimental-test-coverage --test-coverage-include=\"dist/**/*.js\" --test-coverage-lines=85 --test-coverage-branches=80 --test-coverage-functions=80 \"test/*.test.cjs\"",
    "start": "npx tsc && node -r dotenv/config dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "dotenv": "^18.0.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "node-telegram-bot-api": "^2.1.0"
  }
}
